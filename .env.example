APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Вход через Яндекс ID (OAuth): https://oauth.yandex.ru/ — создайте приложение и укажите Redirect URI ниже.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# Должен совпадать с Redirect URI в кабинете OAuth (хост и порт — как у открытого сайта).
YANDEX_REDIRECT_URI="http://127.0.0.1:8000/auth/yandex/callback"
# Если в логе cURL error 60 (SSL) на Windows: скачайте https://curl.se/ca/cacert.pem и укажите абсолютный путь:
# YANDEX_OAUTH_CAFILE=C:/php/extras/ssl/cacert.pem
# Либо отдельный CA для исходящих HTTP-запросов (геокодер): YANDEX_HTTP_CAFILE=...
# Либо отключить проверку SSL только для разработки: YANDEX_HTTP_SSL_VERIFY=false

# Яндекс Карты: JS в браузере + HTTP Геокодер на сервере (адрес по метке).
# Если один ключ «JavaScript API и HTTP Геокодер» — достаточно YANDEX_MAPS_API_KEY.
# Если отдельно «API Геокодера» (Key #2) и отдельно ключ для карты — задайте оба ниже.
YANDEX_MAPS_API_KEY=
# YANDEX_MAPS_JS_API_KEY=          # ключ для api-maps.yandex.ru (иначе берётся YANDEX_MAPS_API_KEY)
# YANDEX_MAPS_HTTP_GEOCODE_KEY=   # ключ для geocode-maps.yandex.ru с сервера (иначе YANDEX_MAPS_API_KEY)

# ЮKassa (онлайн-оплата): https://yookassa.ru/ — тестовый магазин в личном кабинете.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# YOOKASSA_ENABLED=true
# На Windows при ошибке SSL: тот же cacert.pem, что для Яндекса
# YOOKASSA_CAFILE=C:/php/extras/ssl/cacert.pem
# YOOKASSA_SSL_VERIFY=false
# Webhook в кабинете ЮKassa: https://ваш-домен/payments/yookassa/webhook

